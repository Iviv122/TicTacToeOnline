{
  "name": "my-app",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "install": "pnpm -C ./server install && bun install --cwd=./server --production",
    "build": "pnpm -r build && bun build --compile --target bun --outfile server_exec ./server/src/index.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
